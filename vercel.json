{
  "installCommand": "npm --prefix web install && npm --prefix backend install",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/api/engine/:path*", "destination": "/api/engine" },
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/engine/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{web/**,backend/**,blockchain/**,simulator/**,scripts/**,docs/**,**/node_modules/**,prediction-engine/.venv/**,prediction-engine/test_model.py}"
    }
  }
}
