# Copy to .env (gitignored) and fill in: `npm start` and `npm run smoke:emessage` load it.
# Values set in the shell override .env.

# Backend
PORT=4000
INGEST_KEY=change-me               # shared secret the simulator/meter gateway sends as X-Ingest-Key
POSTGRES_URL=                      # Vercel Postgres (Neon) pooled connection string — required, no local-file fallback. Also accepts DATABASE_URL.
ENGINE_URL=http://127.0.0.1:8000   # on Vercel leave unset: defaults to this deployment's /api/engine
ANOMALY_THRESHOLD=0.6
DEMO_MODE=true                     # enables the "Edit a reading (demo)" endpoint; set false outside demos
CYCLE_START=2026-10-01T00:00:00+08:00

# eGov integrations: simulated unless explicitly set to false
USE_MOCK_APIS=true                 # false = all three live
EMESSAGE_LIVE=                     # true = eMessage live while USE_MOCK_APIS=true (likewise EREPORT_LIVE, EGOVCHAIN_LIVE)
EMESSAGE_BASE_URL=                 # gateway base URL; the app appends /messaging/v1/sms/push
EMESSAGE_TOKEN=                    # sent as X-EMESSAGE-Auth; provision securely; never commit
EMESSAGE_TEST_TO=                  # E.164, e.g. +639090000000; every customer SMS goes here in the demo
EREPORT_URL=                        # gateway base URL, e.g. https://platforms-api.e.gov.ph/ereport
EREPORT_ACCESSCODE=                 # exchanged for a short-lived bearer token via POST {EREPORT_URL}/api/integration/token; provision securely; never commit
EGOVCHAIN_URL=                      # gateway base URL, e.g. https://platforms-api.e.gov.ph/egovchain
EGOVCHAIN_TOKEN=                    # NOT a header — appended to the URL path: {EGOVCHAIN_URL}/{EGOVCHAIN_TOKEN}; provision securely; never commit

# EGovChain (Hyperledger Besu, chainId 13371, zero gas) deploy/signing wallet.
# Generate with: cd blockchain && node scripts/generate-wallet.js
EGOVCHAIN_DEPLOYER_KEY=             # never commit
EGOVCHAIN_DEPLOYER_ADDRESS=
EGOVCHAIN_CONTRACT_ADDRESS=         # set after: cd blockchain && npm run deploy

# eReport submit_complaint requires complainant + PSA location fields the
# meter schema doesn't carry. Demo placeholders, same pattern as EMESSAGE_TEST_TO.
EREPORT_DEMO_MOBILE=639999999999
EREPORT_DEMO_FIRST_NAME=Meralco
EREPORT_DEMO_LAST_NAME=Go Demo
EREPORT_DEMO_GENDER=Male            # API enum is strictly Male or Female (confirmed via live 422)
EREPORT_DEMO_EMAIL=demo@example.com
EREPORT_DEMO_REGION_CODE=040000000
EREPORT_DEMO_PROVINCE_CODE=042100000
EREPORT_DEMO_MUNICIPALITY_CODE=042111000
EREPORT_DEMO_BARANGAY_CODE=042111011

# Simulator (read by the backend: simulator/model.mjs derives all meters and readings from these)
# BACKEND_URL is only used by the local clock driver (`npm start`) and `npm run inject`
BACKEND_URL=http://127.0.0.1:4000
SIM_TICK_MS=1000                   # wall-clock ms per simulated 15-minute interval
SIM_BACKFILL_DAYS=12
SIM_METERS=20
SIM_SEED=42
